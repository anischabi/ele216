# Doxyfile minimal pour le laboratoire 4 (seuls les paramètres modifiés sont
# listés ; tous les autres gardent leur valeur par défaut).
#
# Génération, depuis le dossier lab4 :
#     doxygen Doxyfile
# Puis ouvrir doc/html/index.html dans un navigateur.

PROJECT_NAME           = "ELE216 - Laboratoire 4"
PROJECT_BRIEF          = "Types opaques : compteur, servo-moteur, moniteur de batterie"
OUTPUT_LANGUAGE        = French
INPUT_ENCODING         = UTF-8

# Sortie : lab4/doc/html (ignoré par git, voir .gitignore)
OUTPUT_DIRECTORY       = doc
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Fichiers documentés : l'interface (.h) et les tests unitaires (*_test.c) de
# chaque problème et de la mini-app. Les .c d'implémentation, Unity et les
# modules du lab3 réutilisés par le moniteur ne sont pas inclus.
INPUT                  = ACCUEIL.md \
                         probleme1/compteur.h \
                         probleme1/compteur_test.c \
                         probleme2/servo.h \
                         probleme2/servo_test.c \
                         moniteur/moniteur.h \
                         moniteur/moniteur_test.c
USE_MDFILE_AS_MAINPAGE = ACCUEIL.md
FULL_PATH_NAMES        = NO

# Code C
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES

# Affiche le code de chaque test à côté de sa description
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

# Signale ce qui n'est pas documenté
WARN_IF_UNDOCUMENTED   = YES
QUIET                  = YES
